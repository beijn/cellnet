#!/usr/bin/bash
source bin/sh-imports.sh

ssh $HPC_SSH_HOST <<SSH
  if ! type code > /dev/null; then
    mkdir -p ~/.local/bin
    curl -Lk 'https://code.visualstudio.com/sha/download?build=stable&os=cli-alpine-x64' |
      tar -xz -C ~/.local/bin
    echo "Installed VSCode cli to ~/.local/bin; NOTE: Ensure PATH contains ~/.local/bin"
  fi
  $HPC_LIVE code tunnel --accept-server-license-terms 
SSH
